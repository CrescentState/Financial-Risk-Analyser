# Render / Production Environment Variables
# Copy to .env and fill in your values

# Required - Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required - Get from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Optional
GEMINI_MODEL=gemini-2.5-flash
USE_MOCK_DATA=false

# CORS - Comma-separated origins (use * for all, or specific domains)
CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:8501

# Enable/disable API docs in production
ENABLE_DOCS=false

# For local development
# API_BASE_URL=http://localhost:8000/api/v1